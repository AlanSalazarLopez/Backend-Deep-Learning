# ===== Copia este archivo a .env y llena los valores. .env NUNCA se sube a GitHub. =====

# --- Entorno ---
APP_ENV=development
CORS_ORIGINS=*

# --- Base de datos (Supabase) ---
# Supabase > Project Settings > Database > Connection string.
# Usa la cadena del "Session pooler" (funciona con IPv4); la conexión directa del plan gratis puede ser solo IPv6.
DATABASE_URL=

# --- Seguridad ---
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=

# --- Modelo de ML ---
MODEL_KEEP_LAST=3

# --- Para más adelante (déjalo vacío por ahora) ---
RENDER_HEALTH_URL=
